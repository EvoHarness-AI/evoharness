{
	"name": "@evoharness/telemetry",
	"version": "0.0.2",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for evoharness",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./render": {
			"source": "./src/render.ts",
			"types": "./dist/render.d.ts",
			"import": "./dist/render.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "EvoHarness-AI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EvoHarness-AI/evoharness.git",
		"directory": "packages/telemetry"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.12"
	}
}
