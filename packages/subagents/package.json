{
  "name": "@evoharness/subagents",
  "version": "0.84.0",
  "private": true,
  "description": "Evoharness extension for single-agent delegation and scripted multi-agent workflows (ported from pi-subagents v0.84.0)",
  "author": "Nico Bailon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./background-work": "./src/api/background-work.ts",
    "./external-job-provider": "./src/api/external-job-provider.ts",
    "./external-runs": "./src/api/external-runs.ts",
    "./agents": "./src/api/agents.ts",
    "./inspectors": "./src/api/inspectors.ts",
    "./delegation": "./src/api/delegation.ts",
    "./capability-ceiling": "./src/api/capability-ceiling.ts",
    "./workflow-resources": "./src/api/workflow-resources.ts",
    "./required-child-extensions": "./src/api/required-child-extensions.ts",
    "./preflight": "./src/api/preflight.ts",
    "./control-channel": "./src/api/control-channel.ts",
    "./intercom-bridge": "./src/api/intercom-bridge.ts",
    "./child-tool-plan": "./src/api/child-tool-plan.ts",
    "./shared-types": "./src/api/shared-types.ts",
    "./project-panes": "./src/api/project-panes.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-subagents.git"
  },
  "homepage": "https://github.com/nicobailon/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/nicobailon/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "evoharness-package",
    "extension",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --import ./test/support/isolated-temp-root.mjs --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:smoke:tool-activation": "node --experimental-strip-types --test test/smoke/tool-activation.test.ts",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "evoharness": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@evoharness/agent-core": "*",
    "@evoharness/ai": "*",
    "@evoharness/coding-agent": "*",
    "@evoharness/tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@evoharness/agent-core": {
      "optional": true
    },
    "@evoharness/ai": {
      "optional": true
    },
    "@evoharness/coding-agent": {
      "optional": true
    },
    "@evoharness/tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "acorn": "8.18.0",
    "jiti": "2.7.0",
    "undici": "8.12.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@evoharness/agent-core": "0.0.2",
    "@evoharness/ai": "0.0.2",
    "@evoharness/coding-agent": "0.0.2",
    "@evoharness/tui": "0.0.2",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "oxlint": "1.80.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
