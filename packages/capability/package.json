{
	"name": "@evoharness/capability",
	"version": "0.0.2",
	"description": "Capability descriptors and the permission vocabulary every capability declares at registration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"capability",
		"permissions",
		"descriptor",
		"contract"
	],
	"author": "EvoHarness-AI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EvoHarness-AI/evoharness.git",
		"directory": "packages/capability"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"shx": "0.3.4",
		"vitest": "4.1.12"
	}
}
