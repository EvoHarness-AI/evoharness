{
	"name": "@evoharness/env",
	"version": "0.0.2",
	"description": "Remote execution environments for EvoHarness Durable: a small daemon deployed over SSH and its ExecutionEnv client",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"bin",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"build:daemon": "cargo build --manifest-path daemon/Cargo.toml --locked",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"durable-execution",
		"agents",
		"ssh",
		"remote"
	],
	"author": "EvoHarness-AI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EvoHarness-AI/evoharness.git",
		"directory": "packages/env"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@evoharness/chord": "0.0.2",
		"@evoharness/durable": "0.0.2"
	},
	"devDependencies": {
		"shx": "0.3.4",
		"vitest": "4.1.12"
	}
}
