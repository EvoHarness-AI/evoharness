{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@evoharness/chord": ["./packages/chord/src/index.ts"],
			"@evoharness/chord/context": ["./packages/chord/src/context/index.ts"],
			"@evoharness/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@evoharness/chord/next": ["./packages/chord/src/next/index.ts"],
			"@evoharness/chord/next/plugins": ["./packages/chord/src/next-node/plugins/index.ts"],
			"@evoharness/chord/node": ["./packages/chord/src/node.ts"],
			"@evoharness/chord/output": ["./packages/chord/src/output.ts"],
			"@evoharness/chord/telemetry-sqlite": ["./packages/chord/src/telemetry-sqlite/index.ts"],
			"@evoharness/chord/sqlite": ["./packages/chord/src/sqlite/index.ts"],
			"@evoharness/chord/sqlite/node": ["./packages/chord/src/sqlite/node.ts"],
			"@evoharness/chord/sqlite/cloudflare": ["./packages/chord/src/sqlite/cloudflare.ts"],
			"@evoharness/telemetry": ["./packages/telemetry/src/index.ts"],
			"@evoharness/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@evoharness/telemetry/render": ["./packages/telemetry/src/render.ts"],
			"@evoharness/codemode": ["./packages/codemode/src/index.ts"],
			"@evoharness/codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@evoharness/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@evoharness/codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@evoharness/codemode/source": ["./packages/codemode/src/source.ts"],
			"@evoharness/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@evoharness/mcp": ["./packages/mcp/src/index.ts"],
			"@evoharness/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@evoharness/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@evoharness/ai": ["./packages/ai/src/index.ts"],
			"@evoharness/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@evoharness/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@evoharness/ai/dist/*": ["./packages/ai/src/*"],
			"@evoharness/durable": ["./packages/durable/src/index.ts"],
			"@evoharness/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@evoharness/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@evoharness/env": ["./packages/env/src/index.ts"],
			"@evoharness/agent-core": ["./packages/agent/src/index.ts"],
			"@evoharness/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@evoharness/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@evoharness/coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@evoharness/tui": ["./packages/tui/src/index.ts"],
			"@evoharness/tui/*": ["./packages/tui/src/*"],
			"@evoharness/agent-old": ["./packages/agent-old/src/index.ts"],
			"@evoharness/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/ai/catalog/**/*", "packages/durable/test-workers/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
