{
	"name": "@evoharness/web",
	"version": "0.0.2",
	"private": true,
	"description": "Web UI for the EvoHarness coding agent",
	"engines": {
		"node": ">=22.19.0"
	},
	"bin": {
		"evoharness-web": "bin/evoharness-web.js"
	},
	"scripts": {
		"clean": "shx rm -rf .next .next-desktop",
		"dev": "next dev --webpack -H 127.0.0.1 -p 30141",
		"web": "node scripts/web-dev.mjs",
		"dev:lan": "node scripts/lan-server.mjs dev",
		"build": "next build --webpack",
		"start": "next start -H 127.0.0.1 -p 30141",
		"start:lan": "node scripts/lan-server.mjs start",
		"check": "tsc --noEmit",
		"lint": "eslint .",
		"check:deps": "node scripts/check-installed-deps.mjs",
		"pretest:unit": "npm run check:deps",
		"test:unit": "node --experimental-strip-types --test --test-concurrency=4 \"app/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"scripts/**/*.test.mjs\" \"public/**/*.test.mjs\"",
		"test:terminal": "node e2e/terminal.mjs",
		"preview-runtime": "node scripts/build-preview-runtime.mjs",
		"postinstall": "node bin/prepare-terminal.js"
	},
	"dependencies": {
		"@evoharness/agent-core": "0.0.2",
		"@evoharness/ai": "0.0.2",
		"@evoharness/coding-agent": "0.0.2",
		"@evoharness/mcp": "0.0.2",
		"@evoharness/tui": "0.0.2",
		"@radix-ui/react-select": "2.4.1",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"croner": "10.0.1",
		"js-yaml": "5.4.2",
		"mammoth": "1.13.0",
		"next": "16.3.8",
		"node-pty": "1.2.0-beta.15",
		"proper-lockfile": "4.1.2",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"semver": "7.8.5",
		"undici": "8.11.0",
		"web-push": "3.6.7"
	},
	"devDependencies": {
		"@lobehub/streamdown": "1.4.1",
		"@tailwindcss/browser": "4.2.2",
		"@tailwindcss/postcss": "4.2.2",
		"@types/js-yaml": "4.0.9",
		"@types/mdast": "4.0.4",
		"@types/node": "25.5.0",
		"@types/proper-lockfile": "4.1.4",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/react-syntax-highlighter": "15.5.13",
		"@types/semver": "7.8.0",
		"@types/web-push": "3.6.4",
		"ansi_up": "6.0.6",
		"esbuild": "0.28.2",
		"eslint": "9.39.4",
		"eslint-config-next": "16.3.8",
		"jiti": "2.7.0",
		"katex": "0.19.0",
		"mermaid": "11.17.2",
		"playwright": "1.63.0",
		"postcss": "8.5.26",
		"react-markdown": "10.1.0",
		"react-syntax-highlighter": "16.1.1",
		"rehype-katex": "7.0.1",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"sucrase": "3.35.0",
		"tailwindcss": "4.2.2",
		"typescript": "5.9.3"
	}
}
